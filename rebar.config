%%-*- mode: erlang -*-
%% vim: ft=erlang:

{erl_opts, [ debug_info
           , warn_export_vars
           , warn_obsolete_guard
           , warn_unused_import
           , warn_bif_clash
           , warnings_as_errors
           ]}.

{deps, [ {cowboy, "~> 2.13"}
       , {spectra, "~> 0.13.4"}
       ]}.

{xref_checks, [ undefined_function_calls
              , undefined_functions
              , locals_not_used
              , deprecated_function_calls
              , deprecated_functions
              ]}.

%% cowboy_req refers to ranch types, and ranch is only a transitive dep, so
%% without this every -spec naming cowboy_req:req() reports unknown types.
{dialyzer, [{plt_extra_apps, [ranch]}]}.

{cover_enabled, true}.
{cover_print_enabled, true}.

%% examples/ is compiled under the test and examples profiles only, so the
%% examples are verified by CI without ever shipping in the library's ebin.
{profiles,
 [{test,
   [ {extra_src_dirs, ["examples"]}
   , {ct_opts, [{ct_hooks, [ cth_surefire
                           , cth_readable_failonly
                           , cth_readable_shell
                           ]}]}
   ]},
  {examples,
   [ {extra_src_dirs, ["examples"]}
   , {shell, [{apps, [cowboy_specer]}]}
   ]}
 ]}.
